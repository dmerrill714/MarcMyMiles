{
  "name": "MarcMyMiles - Driver Log",
  "short_name": "MarcMyMiles",
  "description": "MarcMyMiles - Driver Log: automatic drive logging above 20 mph, with weekly, monthly, and year-to-date mileage totals that stay on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#080b0a",
  "theme_color": "#080b0a",
  "categories": ["travel", "utilities", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
